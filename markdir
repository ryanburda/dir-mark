#!/bin/bash
#
# markdir -- one printable character, one directory, the way vim marks do.
#
# A mark names a directory and nothing else. `markdir get m` prints the one
# `m` names and `markdir pick` asks with fzf, which makes both of them
# pickers in the ordinary sense: a program that prints a path, ready to be
# fed to anything that takes one.

MARKS_DIR="${MARKDIR_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/markdir}"
mkdir -p "$MARKS_DIR"

markdir_dir() {
  # The directory markdir itself lives in, symlinks followed: the installer
  # links markdir into a directory on PATH, and markdir-status sits beside
  # the file that link points at, not beside the link.
  #
  # readlink in a loop rather than `readlink -f`, which is GNU-only.
  local self="$0" dir

  case "$self" in
    */*) ;;
    *) self=$(command -v -- "$self" 2>/dev/null) || return 1 ;;
  esac

  while [ -L "$self" ]; do
    dir=$(cd "$(dirname "$self")" && pwd -P) || return 1
    self=$(readlink "$self") || return 1
    case "$self" in
      /*) ;;
      *) self="$dir/$self" ;;
    esac
  done

  (cd "$(dirname "$self")" && pwd -P)
}

# The tmux half of markdir: `status`, `status-init` and the refresh the hooks
# it installs call back on. Sourced rather than run, for read_marks below.
MARKDIR_LIB=$(markdir_dir) && [ -f "$MARKDIR_LIB/markdir-status" ] || {
  echo "markdir: could not find markdir-status beside markdir" >&2
  exit 1
}
# shellcheck source=markdir-status
. "$MARKDIR_LIB/markdir-status"

usage() {
  cat <<'EOF'
markdir -- one character, one directory

Usage
  markdir set <char> [path]     # Mark a directory (path defaults to the current directory)
  markdir remove <char>         # Remove a mark
  markdir get <char>            # Print the directory a mark points at
  markdir pick                  # Choose a mark with fzf and print its directory (ctrl-x removes)
  markdir list                  # Every mark as "char<TAB>directory"
  markdir status [path]         # Marks with a tmux session open at them, for a status line
                                # (-s, --style and -c, --current-style set its tmux styles)
  markdir status-init           # Install the tmux hooks `status` needs (put this in tmux.conf)
  markdir help                  # Show help message

Marks
  A mark is one printable character pointing at one directory. Setting a
  character that is already set replaces it, the way `m` does in vim.

  `get` and `pick` print a directory and nothing else, so they compose with
  anything that takes one:

  cd "$(markdir get m)"
  dirsesh at $(markdir get m)
  dirsesh at $(markdir pick)

Storage
  ${XDG_STATE_HOME:-~/.local/state}/markdir/<char>, or $MARKDIR_DIR/<char>.

See https://github.com/ryanburda/markdir for more documentation
EOF
}

####################
# helper functions #
####################
notify() {
  # Show a message: tmux display-message inside tmux, stderr otherwise.
  # stderr because several callers run inside a command substitution whose
  # stdout is their return value.
  local msg="$1"
  if [ -n "$TMUX" ]; then
    tmux display-message "$msg"
  else
    echo "$msg" >&2
  fi
}

markdir_self() {
  # Echo the absolute path to re-run markdir by, or nothing with a non-zero
  # status. Both callers run markdir later in an environment of their own --
  # fzf in a shell, tmux in a hook -- and neither PATH need hold it.
  #
  # The symlink is not followed: the link the installer made is the name
  # markdir is installed under.
  local self="$0"

  case "$self" in
    */*) ;;
    *) self=$(command -v -- "$self" 2>/dev/null) || return 1 ;;
  esac

  printf '%s/%s\n' "$(cd "$(dirname "$self")" && pwd -P)" "$(basename "$self")"
}

is_mark_char() {
  # Succeed if $1 is a single printable ASCII character that also names a
  # file safely: not '/', a path separator, and not '.', which alone names
  # the directory a mark file lives in rather than a mark.
  #
  # Printability is checked by code point rather than a [!-~] range, which
  # outside the C locale is read in collation order; '/' and '.' are ruled
  # out by regex instead, since neither depends on locale.
  #
  # Args:
  #   $1: char: the character to check
  local char="$1" code

  [ "${#char}" -eq 1 ] || return 1
  [[ "$char" =~ ^[/.]$ ]] && return 1

  code=$(printf '%d' "'$char" 2>/dev/null)
  [ -n "$code" ] && [ "$code" -ge 33 ] && [ "$code" -le 126 ]
}

check_mark_char() {
  # Exit unless $1 can key a mark; see is_mark_char.
  #
  # Args:
  #   $1: char: the character to check
  local char="$1"

  if ! is_mark_char "$char"; then
    notify "Error: a mark is keyed by a single printable character, not '/' or '.'"
    exit 1
  fi
}

read_marks() {
  # Emit one "char<TAB>directory" line per mark, sorted by character.
  #
  # A mark is a file at $MARKS_DIR/<char> holding the directory it names.
  # Anything in $MARKS_DIR whose name is not a valid mark character, or
  # whose contents are empty or hold a tab or newline, is dropped: markdir
  # cannot write one, and it would split a line callers read whole.
  local file char dir

  for file in "$MARKS_DIR"/*; do
    [ -f "$file" ] || continue
    char=$(basename "$file")
    is_mark_char "$char" || continue

    dir=$(cat "$file" 2>/dev/null)
    case "$dir" in
      "" | *[$'\t\n']*) continue ;;
    esac

    printf '%s\t%s\n' "$char" "$dir"
  done | LC_ALL=C sort
}

mark_directory() {
  # Echo the directory marked at $1, or nothing with a non-zero status.
  #
  # Args:
  #   $1: char: the mark character to look up
  local char="$1" file dir

  file="$MARKS_DIR/$char"
  [ -f "$file" ] || return 1

  dir=$(cat "$file" 2>/dev/null)
  [ -n "$dir" ] || return 1

  printf '%s\n' "$dir"
}

mark_entries() {
  # The picker's rows: character and directory, tab separated, followed by
  # the "char directory" column that is displayed. fzf shows only the third
  # field (--with-nth); the first two ride along for its bindings.
  local char dir

  while IFS=$'\t' read -r char dir; do
    printf '%s\t%s\t%s    %s\n' "$char" "$dir" "$char" "${dir/#"$HOME"/\~}"
  done < <(read_marks)
}

#################
# api functions #
#################
mark_set() {
  # Mark a directory at a character, replacing whatever that character was
  # marking before -- the way setting a vim mark that is set does.
  #
  # Args:
  #   $1: char: the mark character
  #   $2: path: directory to mark (default: the current directory)
  local char="$1" path="${2:-$PWD}"

  path="${path/#\~/$HOME}"

  if [ ! -d "$path" ]; then
    notify "Error: Directory '$path' does not exist"
    exit 1
  fi

  path=$(cd "$path" && pwd -P)

  if [ -z "$path" ]; then
    notify "Error: Directory '${2:-$PWD}' could not be resolved"
    exit 1
  fi

  # Rejected rather than escaped: a control character would have to survive
  # a whole-line read and the picker, and no directory worth marking has one.
  case "$path" in
    *[[:cntrl:]]*)
      notify "Error: '$path' cannot be marked: its path contains a control character"
      exit 1
      ;;
  esac

  # markdir does not ask for the character itself: inside tmux a key binding
  # asks with command-prompt -1 and passes the answer in (see the README),
  # which is the only way it was ever reached.
  if [ -z "$char" ]; then
    notify "Error: 'markdir set' needs a character to mark ${path/#"$HOME"/\~} at"
    exit 1
  fi

  check_mark_char "$char"

  # Written to a temp file and moved into place, so an interrupted write
  # leaves the old mark rather than half a file.
  local tmp="$MARKS_DIR/.$char.tmp"
  printf '%s\n' "$path" > "$tmp" && mv "$tmp" "$MARKS_DIR/$char"

  # What the status line shows just changed, and no session was created or
  # killed for a tmux hook to notice it.
  refresh_status

  notify "Mark set: $char -> $path"
}

mark_remove() {
  # Remove a mark.
  #
  # Args:
  #   $1: char: the mark character to remove
  local char="$1"

  if [ -z "$char" ]; then
    notify "Error: 'markdir remove' needs a character"
    exit 1
  fi

  check_mark_char "$char"

  if ! mark_directory "$char" > /dev/null; then
    notify "Error: No mark '$char'"
    exit 1
  fi

  rm -f "$MARKS_DIR/$char"

  refresh_status

  notify "Mark removed: $char"
}

mark_get() {
  # Print the directory a mark points at. A picker in its own right: it names
  # a directory and nothing else, so
  #
  #   dirsesh att $(markdir get m)
  #
  # goes straight to a session at whatever m marks, skipping the fzf `pick`
  # opens.
  #
  # Args:
  #   $1: char: the mark character to look up
  local char="$1"

  if [ -z "$char" ]; then
    notify "Error: 'markdir get' needs a character"
    exit 1
  fi

  check_mark_char "$char"

  local dir
  if ! dir=$(mark_directory "$char"); then
    notify "Error: No mark '$char'"
    exit 1
  fi

  printf '%s\n' "$dir"
}

mark_pick() {
  # Choose a mark with fzf and print its directory. Backing out prints
  # nothing and succeeds, the way any picker declines to answer.
  if ! command -v fzf > /dev/null 2>&1; then
    notify "Error: 'markdir pick' needs fzf on PATH"
    exit 1
  fi

  local entries
  entries=$(mark_entries)

  if [ -z "$entries" ]; then
    notify "No marks set"
    exit 1
  fi

  # ctrl-x removes the mark under the cursor, then rebuilds the list from
  # disk. fzf hands a binding to a shell, so markdir's path is quoted for
  # one; fzf itself quotes {1}.
  local self
  self=$(markdir_self) || self="$0"
  printf -v self '%q' "$self"

  local selected
  selected=$(printf '%s\n' "$entries" | fzf \
    --cycle \
    --delimiter=$'\t' \
    --with-nth=3 \
    --prompt "Mark > " \
    --header $':: \e[33mctrl-x\e[0m to \e[31mremove\e[0m' \
    --bind "ctrl-x:execute-silent($self remove {1})+reload($self _entries)")

  [ -n "$selected" ] || exit 0

  # The row carries the directory in its second field, so the answer is the
  # marked path rather than the ~ the row displayed.
  local row="${selected#*$'\t'}"
  printf '%s\n' "${row%%$'\t'*}"
}

# Parse arguments
if [ $# -eq 0 ]; then
  usage
  exit 0
fi

command="$1"
shift

case "$command" in
  set)
    mark_set "$1" "$2"
    ;;
  remove)
    mark_remove "$1"
    ;;
  get)
    mark_get "$1"
    ;;
  pick)
    if [ $# -gt 0 ]; then
      notify "Error: 'markdir pick' takes no arguments"
      exit 1
    fi
    mark_pick
    ;;
  list)
    read_marks
    ;;
  status)
    mark_status "$@"
    ;;
  status-init)
    if [ $# -gt 0 ]; then
      notify "Error: 'markdir status-init' takes no arguments"
      exit 1
    fi
    status_init
    ;;
  _entries)
    # Internal: rebuilds the picker's rows for its reload binding.
    mark_entries
    ;;
  "$HOOK_REFRESH")
    # Internal: invoked by the hooks `markdir status-init` installs.
    refresh_status
    ;;
  help | -h | --help)
    usage
    ;;
  *)
    notify "Error: Unknown command '$command'"
    usage
    exit 1
    ;;
esac
