#!/bin/bash
#
# dir-mark-status -- the tmux half of dir-mark.
#
# Sourced by dir-mark rather than run: it reads marks through `read_marks` and
# reports through `notify`, both of which live in dir-mark itself. Everything
# that knows what tmux is lives here, so the rest of dir-mark is a program that
# maps characters to directories and nothing more.

# The internal verb the hooks call back on. Also the string `dir-mark
# status-init` greps for to recognise a hook it installed before.
HOOK_REFRESH=_refresh-status

####################
# helper functions #
####################
refresh_status() {
  # Redraw every attached client's status line. tmux's own refresh-client
  # reaches only one client, and a status line passing #{session_path} gives
  # each client a #() job of its own, so all of them need the nudge. A no-op
  # outside tmux, where there is nothing to redraw.
  local client

  while IFS= read -r client; do
    [ -n "$client" ] && tmux refresh-client -S -t "$client" 2>/dev/null
  done < <(tmux list-clients -F '#{client_name}' 2>/dev/null)
}

install_status_hook() {
  # Point one global tmux hook at dir-mark's refresh verb. Appended, so
  # anyone else's hooks on it survive; any hook a previous `dir-mark
  # status-init` left on it is dropped first, so re-sourcing tmux.conf does not
  # stack duplicates.
  #
  # Args:
  #   $1: hook: the tmux hook name
  #   $2: self: absolute path to dir-mark
  local hook="$1" self="$2"

  # Unsetting an array element leaves the others at their own indexes, so the
  # indexes collected here stay valid as they are removed.
  local index
  while IFS= read -r index; do
    tmux set-hook -gu "$hook[$index]"
  done < <(tmux show-hooks -g 2>/dev/null \
    | sed -n "s/^$hook\\[\\([0-9]\\{1,\\}\\)\\].*$HOOK_REFRESH.*/\\1/p")

  if ! tmux set-hook -ga "$hook" "run-shell -b \"'$self' $HOOK_REFRESH\""; then
    notify "Error: could not set the tmux '$hook' hook"
    return 1
  fi
}

#################
# api functions #
#################
status_init() {
  # Install the tmux hooks that keep the status line current. Meant for
  # tmux.conf, where it runs once per server:
  #
  #   run-shell "dir-mark status-init"
  #
  # A status line is only redrawn every status-interval seconds, so a session
  # opened or killed elsewhere would otherwise take that long to show up in
  # `dir-mark status`. session-created and session-closed are the two moments
  # its answer changes without dir-mark being involved; setting and removing a
  # mark refresh the line on their own.
  #
  # Both hooks are global: a session's own options are already freed when
  # session-closed fires, so a hook set on the session never runs at all.
  local self
  if ! self=$(dir_mark_self); then
    notify "Error: could not resolve the path to dir-mark"
    exit 1
  fi

  install_status_hook session-created "$self" || exit 1
  install_status_hook session-closed "$self" || exit 1
}

mark_status() {
  # Print the characters of the marks with a tmux session open at them, the
  # current session's styled differently. Only marks with a session open are
  # shown, so the line stays short. Nothing is notified: this runs on every
  # status line redraw.
  #
  # Args:
  #   $1: path: the directory of the session to treat as the current one
  #       (default: the session tmux reports as current)
  #   -s, --style: tmux style for the other sessions' characters
  #   -c, --current-style: tmux style for the current session's character
  local style="dim" current_style="fg=yellow,bold" current="" current_given=""

  # Styles are given without their #[] wrapper, so a status line format
  # holding one does not have to escape it.
  while [ $# -gt 0 ]; do
    case "$1" in
      -s | --style | -c | --current-style)
        if [ $# -lt 2 ]; then
          notify "Error: '$1' needs a tmux style"
          exit 1
        fi
        case "$1" in
          -s | --style) style="$2" ;;
          -c | --current-style) current_style="$2" ;;
        esac
        shift 2
        ;;
      -*)
        notify "Error: Unknown option '$1' for 'dir-mark status'"
        exit 1
        ;;
      *)
        if [ -n "$current_given" ]; then
          notify "Error: Too many arguments for 'dir-mark status'"
          exit 1
        fi
        current="$1"
        current_given=1
        shift
        ;;
    esac
  done

  local open
  open=$(tmux list-sessions -F '#{session_path}' 2>/dev/null)
  [ -n "$open" ] || return 0

  # Which session is current must be given by whoever draws the status line:
  # tmux runs a #() command without a client and shares its output between
  # them all, so asking here would answer the same for every client. A status
  # line passes #{session_path}, expanded per client. Asking is the fallback
  # for a shell with a session of its own.
  if [ -z "$current_given" ] && [ -n "$TMUX" ]; then
    current=$(tmux display-message -p '#{session_path}' 2>/dev/null)
  fi

  # Each character is padded inside its own style, so a style with a
  # background reads as a block. Each style is preceded by a reset, because
  # tmux styles accumulate.
  read_marks | DIR_MARK_OPEN_PATHS="$open" DIR_MARK_CURRENT_PATH="$current" \
    DIR_MARK_STYLE="$style" DIR_MARK_CURRENT_STYLE="$current_style" awk -F'\t' '
      BEGIN {
        n = split(ENVIRON["DIR_MARK_OPEN_PATHS"], paths, "\n")
        for (i = 1; i <= n; i++) if (paths[i] != "") open[paths[i]]
        current = ENVIRON["DIR_MARK_CURRENT_PATH"]
        style = ENVIRON["DIR_MARK_STYLE"]
        current_style = ENVIRON["DIR_MARK_CURRENT_STYLE"]
      }

      $2 in open {
        out = out "#[default]#[" (current != "" && $2 == current ? current_style : style) "] " $1 " "
      }

      END { if (out != "") print out "#[default]" }
    '
}
